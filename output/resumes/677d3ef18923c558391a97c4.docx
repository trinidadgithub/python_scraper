<link rel="stylesheet" type="text/css" href="https://www.tekjobs.net/assets/css/bootstrap-multiselect.css">
<style type="text/css">
  .multiselect-container{
    width: 300px;
  }
  .multiselect-item > a,.multiselect-container >li>a{
    color: black;
  }
  .send-mail-to-input {
    height: 27px;
    width: 62px;
    padding: 2px 10px;
  }
  .span-offer {
    text-transform: none;
    font-size: 0.8em;
    color: #ff6a6a;
    margin-right: 3em;
  }
</style>

