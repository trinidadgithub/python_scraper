    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta/js/bootstrap.min.js" integrity="sha384-h0AbiXch4ZDo7tp9hKZ4TsHbi047NrKGLO3SEJAg45jXxnGIfYzk4Si90RDIqNm1" crossorigin="anonymous"></script>

    <script type="text/javascript">
      $(document).ready(function() {

        $("#fileInput").on('change', function() {
          $("#changeImage").submit();
        });

        $("#changeImage").on('submit', function() {
          let image_type = $("#image_type").val();
          let imgId = 'imgProfile';
          let baseurl = "https://www.tekjobs.net/employer/dashboard/uploadImage/";
          if(image_type == 'profile') {
            baseurl = "https://www.tekjobs.net/employer/dashboard/uploadImage/1";
            imgId = 'imgProfile';
          }
          $.ajax({
            url: baseurl,
            type: "POST",
            data:  new FormData(this),
            contentType: false,
            cache: false,
            processData:false,
            beforeSend : function() {
              // $("#upload_pencil").prop('disabled', true);
            },
            success: function(data) {
              let jsonData = JSON.parse(data);
              if(jsonData.hasOwnProperty('success') && jsonData.hasOwnProperty('profile_pic')) {
                console.log(jsonData.profile_pic);
                $("#"+imgId).prop('src', jsonData.profile_pic);
              
              } else if(jsonData.hasOwnProperty('error')){
                alert(jsonData.profile_pic);
              } else {
                window.location.reload();
              }
            }   
          });
          return false;
        });

        $("#formChangePassword").on('submit', function() {
          const oldPwd = $("#old_password").val();
          const newPwd = $("#new_password").val();
          const cnfPwd = $("#cnf_password").val();
          if(newPwd !== cnfPwd) {
            $("#errorchangepwd").html('New Password and Confirm Password should be identical');
          }
          else if(oldPwd === newPwd) {
            $("#errorchangepwd").html('Current Password and New Password should not be same');
          } else {
            console.log('identical');
            $("#errorchangepwd").html('');
            const formData = $("#formChangePassword").serialize();
            console.log(formData);
            $.ajax({
              url: "https://www.tekjobs.net/employer/dashboard/changePassword",
              type: "POST",
              data: formData,
              success: function(data) {
                // console.log(data);
                const jsonData = JSON.parse(data);
                if(jsonData.hasOwnProperty('success')) {
                  $("#errorchangepwd").html('Successfully updated password');
                } else if(jsonData.hasOwnProperty('error')) {
                  $("#errorchangepwd").html(jsonData.error);
                } else {
                  $("#errorchangepwd").html('something went wrong');
                  setTimeout(()=> {
                    window.location.reoad();
                  }, 1000);
                }
              }
            });
          }
          return false;
        });
      });
    </script>
</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js" integrity="sha512-37T7leoNS06R80c8Ulq7cdCDU5MNQBwlYoy1TX/WUsLFC2eYNqtKlV0QjH7r8JpG/S0GUMZwebnVFLPd6SU5yg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script type="text/javascript" src="https://www.tekjobs.net/assets/js/bootstrap-multiselect.js"></script>
<script src="https://www.tekjobs.net/tinymce/tinymce.min.js"></script>

<script type="text/javascript">
  let formError = "";
  let pre_relocation_city = [];
  if(formError != '') {
    alert(formError);
  }

  function empSendMail(currId=0) {
    let checkedIds = [];
    if(!currId) {
      $(".resume-checkbox:checked").each(function() {
        let currId1 = this.id.split('sel_');
        checkedIds.push(currId1[1]);
      })
    } else {
      checkedIds.push(currId);
    }
    let mongo_ids = '';
    $.each(checkedIds, function(key, value) {
      mongo_ids += value+',';
    });
    $("#mongo_ids").val(mongo_ids);
  }

  $("input[name='sendMailTo']").on('change', ()=> {
    if($("input[name='sendMailTo']:checked").val() === 'E') {
      $("#sendMailToRecentEntered").prop('disabled', false);
      $("#sendMailToRecentEntered").prop('required', true);
    } else {
      $("#sendMailToRecentEntered").prop('disabled', true);
      $("#sendMailToRecentEntered").prop('required', false);
    }
  })

  function empSendSms(currId=0) {
    let checkedIds = [];
    if(!currId) {
      $(".resume-checkbox:checked").each(function() {
        let currId1 = this.id.split('sel_');
        checkedIds.push(currId1[1]);
      })
    } else {
      checkedIds.push(currId);
    }
    let mongo_ids = '';
    $.each(checkedIds, function(key, value) {
      mongo_ids += value+',';
    });
    $("#sms_mongo_ids").val(mongo_ids);
  }

  function downloadResume(currId=0) {
    let checkedIds = [];
    if(!currId) {
      $(".resume-checkbox:checked").each(function() {
        let currId1 = this.id.split('sel_');
        checkedIds.push(currId1[1]);
      })
    } else {
      checkedIds.push(currId);
    }
    let mongo_ids = '';
    $.each(checkedIds, function(key, value) {
      mongo_ids += value+',';
    });

    $("#input_mongo_ids").val(mongo_ids);
    $("#form_download_resume").submit();
  }

  function exportExcel() {
    let checkedIds = [];
    $(".resume-checkbox:checked").each(function() {
      let currId1 = this.id.split('sel_');
      checkedIds.push(currId1[1]);
    })
    let mongo_ids = '';
    $.each(checkedIds, function(key, value) {
      mongo_ids += value+',';
    });

    $("#excel_list_mongo_ids").val(mongo_ids);
    $("#form_export_excel").submit();
  }

  function enableOrDisable() {
    let checkedCount = $(".resume-checkbox:checked").length;
    if(checkedCount == 0) {
      $("#sendMail").attr('disabled','disabled');
      $("#btnDownloadResume").attr('disabled','disabled');
      $("#btnSendSMS").attr('disabled','disabled');
      $("#btnExportList").attr('disabled','disabled');
    } else {
      $("#sendMail").removeAttr('disabled');
      $("#btnDownloadResume").removeAttr('disabled');
      $("#btnSendSMS").removeAttr('disabled');
      $("#btnExportList").removeAttr('disabled')
    }
  }

  function selectState() {
    // const countryIds = $("#selectCountry").val();
    const countryIds = $("input[name='country[]']").val();
    /*if(countryIds.length > 1 || countryIds.length == 0) {
      $("#selectoption").html('');
      $("#selectoption").multiselect('rebuild');
      return false;
    } else {
      countryId = countryIds[0];
    }*/
    countryId = countryIds;
    if(countryId == 0) {
      window.location.replace('https://www.tekjobs.net/employer/searchResume/index/1/?country=usa');
    }

    $.ajax({
      url: "https://www.tekjobs.net/support/getStatesByCountryIdJson",
      type: "POST",
      data: { countryId : countryId },
      success: function(data) {
        const jsonData = JSON.parse(data);
        let statesHtml = '';
        $.each(jsonData, function(key, value) {
          if(pre_relocation_city.length > 0 && pre_relocation_city.includes(value.stateId)) {
              statesHtml += '<option value="'+value.stateId+'" selected>'+value.stateName+'</option>';
          } else {
              statesHtml += '<option value="'+value.stateId+'">'+value.stateName+'</option>';
          }
        });
        $("#selectoption").html(statesHtml);
        $("#selectoption").multiselect('rebuild');
        pre_relocation_city = [];
      }
    });
  }

  $(document).ready(function() {
    enableOrDisable();
    selectState();

    $(".page-link").on('click', function() {
      let currHref = $(this).attr('href');
      if(currHref != '#') {
          currHref += '/?country='+"usa";
          currHref = currHref.replace('index//', 'index/');
          $("#formCandidateSearch").attr('action', currHref);
          $("#formCandidateSearch").submit();
      }
      return false;
    });

    $("#visa_select_all").on('change', function() {
      $("input[name='visa_type[]']").prop('checked', this.checked);
    })

    $("#status_select_all").on('change', function() {
      $("input[name='resumeStatus[]']").prop('checked', this.checked);
    })

    $("#paid_resume_select_all").on('change', function() {
      $("input[name='paidResume[]']").prop('checked', this.checked);
    })

    $("#selst").on('change', function() {
      $('.resume-checkbox').prop('checked', this.checked);
      enableOrDisable();
    });

    $(".resume-checkbox").on('change', function(){
      enableOrDisable();
    });
    $("#perPage,#sortBy").on('change', function() {
      $("#formCandidateSearch").submit();
    });

    /*$.validator.addMethod("isEmailVerified", function(value, element) {
        // return this.optional(element) || (parseFloat(value) > 0);
        if(/^\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$/.test(value)) {
          $.ajax({
            url: "https://www.tekjobs.net/support/isVerifiedEmail",
            data: {email: value},
            type: "POST",
            success: function(data) {
              const jdata = JSON.parse(data);
              if(jdata.hasOwnProperty('success')) {

              } else {
                
              }
            }
          })
        }
    }, "Email is not verified");
    */

    $("#formSendMail").validate({
      rules: {
        from: {
          required: true,
          email: true,
          // isEmailVerified: true,
        },
        subject: {
          required: true,
          minlength: 5
        }
      },
      messages: {
        subject: {
          required: "Subject is required",
          minlength: "Subject must be at least 5 characters long"
        },
        from: {
          required: "Please enter a valid email address"
        },
        otp: {
          isCorrect: 'Incorrect OTP',
        }
      },
      submitHandler: function(form) {
        const email = $("#from_email").val();
        $.ajax({
          url: "https://www.tekjobs.net/support/isVerifiedEmail",
          data: {email},
          type: "POST",
          success: function(data) {
            const jdata = JSON.parse(data);
            if(jdata.hasOwnProperty('success')) {
              if(jdata.hasOwnProperty('verification_required') && jdata.verification_required === false) {
                sendEmailFormSubmit();
                // alert('form submit');
              } else {
                // alert('otp popup');
                $("#exampleModalCenter").modal('hide');
                $("#labelOTP").html('We have shared a verification code at '+ email);
                $("#email_verify").val(email);
                $("#exampleModalVerifyOTP").modal('show');
              }
            } else if(jdata.hasOwnProperty('error')){
              alert(jdata.error)
            } else {
              alert('Something went wrong');
            }
          }
        });
        /*
        */
        return false;
      }
    });

    $("#formSendSMS").on('submit', function() {
      const formData = $("#formSendSMS").serialize();
      // console.log(formData);
      $("#btnSendSMS").prop('disabled', true);
      setTimeout(()=> {
        $("#btnSendSMS").prop('disabled', false);
      }, 2000);
      $.ajax({
        url: "https://www.tekjobs.net/employer/searchResume/sendSMS",
        data: formData,
        type: "POST",
        success: function(data) {
          // console.log(data);
          const jsonData = JSON.parse(data);
          if(jsonData.hasOwnProperty('success')) {
            alert('successfully mail send to candidate');
            $(".close").trigger('click');
          } else if(jsonData.hasOwnProperty('error')) {
            alert(jsonData.error);
          } else {
            alert('something went wrong');
          }
        }
      });
      return false;
    });

    $("#formVerifyOTP").on('submit', function() {
      const formData = $("#formVerifyOTP").serialize();
      // console.log(formData);
      $("#btnVerifyOTP").prop('disabled', true);
      setTimeout(()=> {
        $("#btnVerifyOTP").prop('disabled', false);
      }, 2000);
      $.ajax({
        url: "https://www.tekjobs.net/support/verifyOtp",
        data: formData,
        type: "POST",
        success: function(data) {
          // console.log(data);
          const jsonData = JSON.parse(data);
          if(jsonData.hasOwnProperty('success')) {
            $("#errorOTP").html('');
            sendEmailFormSubmit();
            $(".close").trigger('click');
          } else if(jsonData.hasOwnProperty('error')) {
            $("#errorOTP").html(jsonData.error)
          } else {
            $("#errorOTP").html('something went wrong');
          }
        }
      });
      return false;
    });

    $("#shareNDownload_form").on('submit', function(event) {
      event.preventDefault();
      const formData = $("#shareNDownload_form").serializeArray();
      const jsonData = {};
      formData.forEach(data => {
        jsonData[data.name] = data.value;
        // $("#formCandidateSearch").append($(`#shareNDownload_form input=['${data.name}']`));
      });
      // console.log(jsonData);
      $("#downloadNSendMailValues").val(JSON.stringify(jsonData));
      $("#downloadNSendMailAction").val("downloadNShare");
      // console.log($("#formCandidateSearch").serialize());
      $("#formCandidateSearch").submit();
      $("#downloadNSendMailValues").val("");
      $("#downloadNSendMailAction").val("");
    });

    $("#btnDownloadExcelList").on('click', function() {
      $("#downloadNSendMailAction").val("downloadNShare");
      $("#formCandidateSearch").submit();
      $("#downloadNSendMailAction").val("");

    })

  });

  function sendEmailFormSubmit() {
    const formData = $("#formSendMail").serialize();
    // console.log(formData);
    $("#btnSendMail").prop('disabled', true);
    setTimeout(()=> {
      $("#btnSendMail").prop('disabled', false);
    }, 2000);
    alert('Intializing your request');
    $(".close").trigger('click');
    $.ajax({
      url: "https://www.tekjobs.net/employer/searchResume/sendMail",
      data: formData,
      type: "POST",
      success: function(data) {
        // console.log(data);
        const jsonData = JSON.parse(data);
        if(jsonData.hasOwnProperty('success')) {
          alert('Processing Your Request');
          // $(".close").trigger('click');
        } else if(jsonData.hasOwnProperty('error')) {
          alert(jsonData.error);
        } else {
          alert('something went wrong');
        }
      }
    });
    return false;
  }

</script>
<script>
$(document).ready(function() {
//Preloader
preloaderFadeOutTime = 500;
function hidePreloader() {
  var preloader = $('.spinner-wrapper');
  preloader.fadeOut(preloaderFadeOutTime);
}
hidePreloader();
});
</script>
<script type="text/javascript">
  
  $('#selectoption').multiselect({
    includeSelectAllOption: true,
    nonSelectedText: 'Select States',
    enableFiltering: true,
    buttonWidth: '300px'
  });

  /*$('#selectCountry').multiselect({
    includeSelectAllOption: true,
    nonSelectedText: 'Select Countries',
    enableFiltering: true,
    buttonWidth: '258px'
  });*/

  $('#selectCategory').multiselect({
    includeSelectAllOption: true,
    nonSelectedText: 'Select Categories',
    enableFiltering: true,
    buttonWidth: '300px'
  });

  $('#organization').multiselect({
    includeSelectAllOption: true,
    nonSelectedText: 'Select Organization',
    enableFiltering: true,
    buttonWidth: '100%'
  });

  tinymce.init({
    selector: "#emailBody",
    plugins: "lists",
    width : "100%",
    height: "400px",
    toolbar: "undo redo | bold italic underline | fontselect | numlist bullist | cut copy paste | alignleft aligncenter alignright alignjustify | indent outdent",
