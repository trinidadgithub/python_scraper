  function resetForm() {
    // document.getElementById("formCandidateSearch").reset();
    $('#visa_select_all').prop('checked', false);
    $("input[name='visa_type[]']:checkbox").prop('checked',false);
    $("input[name='paidResume[]']:checkbox").prop('checked',false);
    $("#organization").multiselect('clearSelection');
    $("select[name='min_exp']").val("-1");
    $("select[name='max_exp']").val("-1");
    $("input[name='minRate']").val("");
    $("input[name='maxRate']").val("");

    $("select[name='rate_type']").val("");
    $("input[name='tax_type[]']:checkbox").prop('checked',false);
    $("input[name='isOnlyLocal']:checked").prop("checked", false);

    $("input[name='relocate'][value='']").prop('checked',true);
    $("input[name='video_available'][value='']").prop('checked',true);
    $("input[name='tillActive'][value='0']").prop('checked',true);
    // $("radio").prop("checked", false);
    $("#formCandidateSearch").submit();
  }

</script>