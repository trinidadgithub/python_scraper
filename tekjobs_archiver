#!/usr/bin/env python3
"""
TekJobs Resume Archiver

Automates:
1) Crawling candidate profile URLs from a TekJobs company page
2) Opening each profile and extracting contact details
3) Submitting each profile URL to archive.ph/archive.today
4) Downloading resume files (.doc/.docx/pdf if available)
5) Writing a CSV and XLSX report
6) Optionally uploading resumes to GitHub and storing public links in the report

Important:
- This script launches a visible browser and starts processing the public TekJobs page.
- archive.ph may occasionally show anti-bot challenges.
"""

from __future__ import annotations

import csv
import json
import os
import re
import sys
import time
from dataclasses import dataclass, asdict
from pathlib import Path
from typing import Dict, List, Optional, Set
from urllib.parse import quote, urljoin, urlparse

import requests
from openpyxl import Workbook
from playwright.sync_api import BrowserContext, Page, TimeoutError as PlaywrightTimeoutError
from playwright.sync_api import sync_playwright

# -----------------------------
# Configuration
# -----------------------------
COMPANY_PAGE_URL = "https://www.tekjobs.net/staticpage/companyPageDetails/651c4a142544e25a8b6115ed"
EXPECTED_TOTAL_ROWS = 950
OUTPUT_DIR = Path("output")
RESUME_DIR = OUTPUT_DIR / "resumes"
CHECKPOINT_FILE = OUTPUT_DIR / "checkpoint.json"
CSV_FILE = OUTPUT_DIR / "tekjobs_export.csv"
XLSX_FILE = OUTPUT_DIR / "tekjobs_export.xlsx"

# Set to False if you want to run browser in background (not recommended for first run)
HEADLESS = False

# Delay between profiles to reduce server load
PROFILE_DELAY_SECONDS = 1.0

# Archive domains to try
ARCHIVE_DOMAINS = [
    "https://archive.ph",
    "https://archive.today",
    "https://archive.is",
]

# Optional GitHub upload settings (set as environment variables)
# GITHUB_TOKEN = personal access token with repo write access
# GITHUB_REPO = owner/repo (example: myuser/tekjobs-archive)
# GITHUB_BRANCH = optional (default: main)
GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "").strip()
GITHUB_REPO = os.environ.get("GITHUB_REPO", "").strip()
GITHUB_BRANCH = os.environ.get("GITHUB_BRANCH", "main").strip()


@dataclass
class CandidateRow:
    name: str
    city: str
    email: str
    phone: str
    profile_url: str
    archived_profile: str
    resume_link: str


def ensure_folders() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    RESUME_DIR.mkdir(parents=True, exist_ok=True)


def normalize_whitespace(value: str) -> str:
    return re.sub(r"\s+", " ", (value or "")).strip()


def load_checkpoint() -> Dict:
    if CHECKPOINT_FILE.exists():
        try:
            return json.loads(CHECKPOINT_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {
        "profile_urls": [],
        "processed": {},
    }


def save_checkpoint(data: Dict) -> None:
    CHECKPOINT_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")


def to_absolute(base_url: str, href: str) -> str:
    return urljoin(base_url, href)


def extract_profile_urls_from_html(base_url: str, html: str) -> List[str]:
    # Capture TekJobs profile URLs from page HTML
    matches = re.findall(r'href=["\']([^"\']*/employer/searchResume/resume/[a-zA-Z0-9]+)["\']', html)
    results = []
    seen: Set[str] = set()
    for href in matches:
        full = to_absolute(base_url, href)
        if full not in seen:
            seen.add(full)
            results.append(full)
    return results


def collect_profile_urls(page: Page, target_count: int) -> List[str]:
    """
    Crawl listing pages and collect unique resume profile URLs.
    This function attempts to paginate by clicking common "next" controls.
    """
    print("[INFO] Loading company page...")
    page.goto(COMPANY_PAGE_URL, wait_until="domcontentloaded", timeout=120000)

    all_urls: List[str] = []
    seen: Set[str] = set()

    stagnant_rounds = 0
    max_stagnant_rounds = 4

    while len(all_urls) < target_count and stagnant_rounds < max_stagnant_rounds:
        page.wait_for_timeout(1500)
        html = page.content()
        page_urls = extract_profile_urls_from_html(page.url, html)

        before = len(all_urls)
        for u in page_urls:
            if u not in seen:
                seen.add(u)
                all_urls.append(u)

        gained = len(all_urls) - before
        print(f"[INFO] Collected {len(all_urls)} unique profile URLs (+{gained})")

        if gained == 0:
            stagnant_rounds += 1
        else:
            stagnant_rounds = 0

        # Try pagination buttons/links
        clicked = False
        next_selectors = [
            "a[rel='next']",
            "a:has-text('Next')",
            "button:has-text('Next')",
            "li.next a",
            ".pagination-next a",
            ".paginate_button.next a",
            ".paginate_button.next",
        ]

        for selector in next_selectors:
            try:
                loc = page.locator(selector).first
                if loc.count() and loc.is_visible():
                    loc.click(timeout=3000)
                    clicked = True
                    break
            except Exception:
                continue

        if not clicked:
            # Last attempt: press PageDown to force lazy load then continue
            page.keyboard.press("PageDown")
            page.wait_for_timeout(1000)

        # safety break when no next control and no new links
        if not clicked and gained == 0:
            break

    return all_urls


def extract_first(pattern: str, text: str) -> str:
    m = re.search(pattern, text, flags=re.IGNORECASE)
    return normalize_whitespace(m.group(1)) if m else ""


def parse_candidate_from_page(page: Page, profile_url: str) -> Dict[str, str]:
    page.goto(profile_url, wait_until="domcontentloaded", timeout=120000)
    page.wait_for_timeout(1500)

    # Build data from the entire text for resilience against markup changes
    full_text = normalize_whitespace(page.inner_text("body"))

    # Heuristics
    name = ""
    title_candidates = [
        page.locator("h1").first,
        page.locator("h2").first,
        page.locator(".candidate-name").first,
    ]
    for loc in title_candidates:
        try:
            if loc.count():
                value = normalize_whitespace(loc.inner_text())
                if value and len(value.split()) <= 6:
                    name = value
                    break
        except Exception:
            pass

    if not name:
    #    name = extract_first(r"Name\s*[:\-]\s*([A-Za-z .'-]{2,80})", full_text)
        name = extract_first(r"(?:Candidate\s*Name|Full\s*Name|Resume\s*of|Applicant)\s*[:\-]\s*([A-Za-z .'-]{2,80})", full_text)

    # city = extract_first(r"City\s*[:\-]\s*([A-Za-z .'-]{2,80})", full_text)
    city = extract_first(r"(?:Current\s*Location|City|Location)\s*[:\-]\s*([A-Za-z0-9 ,.'-]{2,120})", full_text)
    
        # Final fallback: use profile id so CSV isn't blank
    if not name:
        profile_id = profile_url.rstrip("/").split("/")[-1]
        name = f"candidate-{profile_id[:12]}"
    
    if not city:
        city = extract_first(r"Location\s*[:\-]\s*([A-Za-z0-9 ,.'-]{2,120})", full_text)

    email = extract_first(r"([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})", full_text)
    phone = extract_first(r"(\+?\d[\d\-() ]{7,}\d)", full_text)

    resume_url = ""
    # Find direct href to document-like links
    anchors = page.locator("a")
    try:
        count = anchors.count()
    except Exception:
        count = 0

    for i in range(count):
        try:
            href = anchors.nth(i).get_attribute("href") or ""
            text = (anchors.nth(i).inner_text() or "").lower()
            if not href:
                continue
            href_l = href.lower()
            if any(k in href_l for k in ["resume", "download"]) or any(k in text for k in ["resume", "download"]):
                if any(ext in href_l for ext in [".doc", ".docx", ".pdf"]) or "download" in href_l or "resume" in href_l:
                    resume_url = to_absolute(page.url, href)
                    break
        except Exception:
            continue

    return {
        "name": name,
        "city": city,
        "email": email,
        "phone": phone,
        "resume_url": resume_url,
    }


def sanitize_filename(name: str) -> str:
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", name).strip("_")
    return name[:140] or "resume"


def file_extension_from_url(url: str) -> str:
    path = urlparse(url).path.lower()
    for ext in [".docx", ".doc", ".pdf"]:
        if path.endswith(ext):
            return ext
    return ".docx"


def download_resume(context: BrowserContext, resume_url: str, profile_id: str) -> Optional[Path]:
    if not resume_url:
        return None

    ext = file_extension_from_url(resume_url)
    out_path = RESUME_DIR / f"{sanitize_filename(profile_id)}{ext}"

    try:
        response = context.request.get(resume_url, timeout=120000)
        if response.ok:
            body = response.body()
            out_path.write_bytes(body)
            if out_path.stat().st_size > 0:
                return out_path
    except Exception:
        pass

    return None


def archive_profile(page: Page, profile_url: str) -> str:
    """
    Best-effort archiving.
    archive.ph can show anti-bot pages.
    """
    for domain in ARCHIVE_DOMAINS:
        try:
            submit_url = f"{domain}/?url={quote(profile_url, safe='')}"
            page.goto(submit_url, wait_until="domcontentloaded", timeout=120000)
            page.wait_for_timeout(3500)

            current = page.url
            # If redirected to actual archive snapshot, this is our link
            if current.startswith(domain) and "?url=" not in current and "/wip/" not in current:
                return current

            # Some flows render a result link with id="SHARE_LONGLINK" or similar
            link_selectors = [
                "#SHARE_LONGLINK",
                "input#SHARE_LONGLINK",
                "a#row0",
                "a[href*='archive']",
            ]
            for sel in link_selectors:
                loc = page.locator(sel).first
                if loc.count():
                    href = loc.get_attribute("href") or loc.input_value() if hasattr(loc, "input_value") else ""
                    if href and href.startswith("http"):
                        return href

            # Might still be processing, try tiny wait and URL check
            page.wait_for_timeout(2500)
            current = page.url
            if current.startswith(domain) and "?url=" not in current and "/wip/" not in current:
                return current
        except Exception:
            continue

    return ""


def github_upload_if_configured(local_file: Path) -> str:
    """
    Upload file to GitHub repo using Contents API and return a raw URL.
    If not configured, return local file path.
    """
    if not (GITHUB_TOKEN and GITHUB_REPO):
        return str(local_file.resolve())

    import base64

    rel_path = f"resumes/{local_file.name}"
    api_url = f"https://api.github.com/repos/{GITHUB_REPO}/contents/{rel_path}"
    headers = {
        "Authorization": f"Bearer {GITHUB_TOKEN}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }

    content_b64 = base64.b64encode(local_file.read_bytes()).decode("ascii")

    # Check if file exists to include SHA for updates
    sha = None
    existing = requests.get(api_url, headers=headers, timeout=60)
    if existing.status_code == 200:
        sha = existing.json().get("sha")

    payload = {
        "message": f"Add resume {local_file.name}",
        "content": content_b64,
        "branch": GITHUB_BRANCH,
    }
    if sha:
        payload["sha"] = sha

    resp = requests.put(api_url, headers=headers, json=payload, timeout=120)
    if resp.status_code not in (200, 201):
        print(f"[WARN] GitHub upload failed for {local_file.name}: {resp.status_code} {resp.text[:300]}")
        return str(local_file.resolve())

    return f"https://raw.githubusercontent.com/{GITHUB_REPO}/{GITHUB_BRANCH}/{rel_path}"


def write_outputs(rows: List[CandidateRow]) -> None:
    # CSV
    with CSV_FILE.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            "Name",
            "City",
            "Email Address",
            "Phone Number",
            "Profile URL",
            "Archived Profile",
            "Resume Link",
        ])
        for r in rows:
            writer.writerow([
                r.name,
                r.city,
                r.email,
                r.phone,
                r.profile_url,
                r.archived_profile,
                r.resume_link,
            ])

    # XLSX
    wb = Workbook()
    ws = wb.active
    ws.title = "TekJobs Export"
    ws.append([
        "Name",
        "City",
        "Email Address",
        "Phone Number",
        "Profile URL",
        "Archived Profile",
        "Resume Link",
    ])
    for r in rows:
        ws.append([
            r.name,
            r.city,
            r.email,
            r.phone,
            r.profile_url,
            r.archived_profile,
            r.resume_link,
        ])

    # Basic autofit approximation
    for col in ws.columns:
        max_len = 0
        col_letter = col[0].column_letter
        for cell in col:
            value = "" if cell.value is None else str(cell.value)
            max_len = max(max_len, len(value))
        ws.column_dimensions[col_letter].width = min(max(12, max_len + 2), 70)

    wb.save(XLSX_FILE)


def profile_id_from_url(url: str) -> str:
    return url.rstrip("/").split("/")[-1]


def main() -> int:
    ensure_folders()

    checkpoint = load_checkpoint()
    processed: Dict[str, Dict] = checkpoint.get("processed", {})

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=HEADLESS)
        context = browser.new_context(accept_downloads=True)
        page = context.new_page()

        # Load target listing page
        page.goto(COMPANY_PAGE_URL, wait_until="domcontentloaded", timeout=120000)

        all_profile_urls = checkpoint.get("profile_urls") or []
        if not all_profile_urls:
            all_profile_urls = collect_profile_urls(page, EXPECTED_TOTAL_ROWS)
            checkpoint["profile_urls"] = all_profile_urls
            save_checkpoint(checkpoint)

        print(f"[INFO] Total profile URLs ready: {len(all_profile_urls)}")

        output_rows: List[CandidateRow] = []

        # Replay already processed from checkpoint first
        for url in all_profile_urls:
            existing = processed.get(url)
            if existing:
                output_rows.append(CandidateRow(**existing))

        archive_tab = context.new_page()

        MAX_PROFILES = 5

        for idx, profile_url in enumerate(all_profile_urls[:MAX_PROFILES], start=1):
            if profile_url in processed:
                continue

            print(f"\n[INFO] Processing {idx}/{len(all_profile_urls)}: {profile_url}")
            pid = profile_id_from_url(profile_url)

            try:
                fields = parse_candidate_from_page(page, profile_url)
            except PlaywrightTimeoutError:
                print("[WARN] Timeout opening profile; saving empty row and continuing.")
                fields = {
                    "name": "",
                    "city": "",
                    "email": "",
                    "phone": "",
                    "resume_url": "",
                }

            archived_url = archive_profile(archive_tab, profile_url)
            if not archived_url:
                print("[WARN] Could not get archive URL for this profile.")

            resume_local = download_resume(context, fields.get("resume_url", ""), pid)
            if resume_local:
                resume_link = github_upload_if_configured(resume_local)
            else:
                resume_link = ""
                print("[WARN] Resume not found/downloaded for this profile.")

            row = CandidateRow(
                name=fields.get("name", ""),
                city=fields.get("city", ""),
                email=fields.get("email", ""),
                phone=fields.get("phone", ""),
                profile_url=profile_url,
                archived_profile=archived_url,
                resume_link=resume_link,
            )

            processed[profile_url] = asdict(row)
            checkpoint["processed"] = processed
            save_checkpoint(checkpoint)

            output_rows.append(row)
            write_outputs(output_rows)

            time.sleep(PROFILE_DELAY_SECONDS)

        browser.close()

    # Final deduped and sorted output to keep deterministic
    unique_map = {r.profile_url: r for r in output_rows}
    final_rows = [unique_map[u] for u in all_profile_urls if u in unique_map]
    write_outputs(final_rows)

    print("\n[DONE] Export complete.")
    print(f"CSV:  {CSV_FILE.resolve()}")
    print(f"XLSX: {XLSX_FILE.resolve()}")
    print(f"Resumes folder: {RESUME_DIR.resolve()}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\n[INFO] Interrupted by user. Partial progress is saved in checkpoint.")
        raise SystemExit(130)
